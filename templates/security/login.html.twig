{% extends 'base.html.twig' %}

{% block title %}Connexion - BetPlatform{% endblock %}

{% block body %}
    <div class="flex items-center justify-center py-12">
        <div class="bg-brand-card w-full max-w-md p-8 rounded-lg border border-gray-800 shadow-2xl">

            <h1 class="text-2xl font-black italic uppercase tracking-tighter text-white text-center mb-6">
                Se <span class="text-brand-red">Connecter</span>
            </h1>

            <form method="post">

                {% if error %}
                    <div class="bg-brand-red/20 border border-brand-red text-red-200 px-4 py-3 rounded mb-4 text-sm text-center">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="bg-gray-800/80 border border-gray-700 text-gray-300 px-4 py-3 rounded mb-6 text-sm text-center">
                        Vous êtes déjà connecté(e) en tant que <strong class="text-white">{{ app.user.userIdentifier }}</strong>.<br>
                        <a href="{{ logout_path() }}" class="text-brand-red hover:text-white transition mt-2 inline-block font-semibold">Me déconnecter</a>
                    </div>
                {% endif %}

                <div class="mb-4">
                    <label for="username" class="block text-gray-400 text-sm font-bold mb-2">Email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username" class="w-full bg-brand-dark border border-gray-700 text-white rounded px-4 py-3 focus:outline-none focus:border-brand-red focus:ring-1 focus:ring-brand-red transition" autocomplete="email" required autofocus>
                </div>

                <div class="mb-6">
                    <label for="password" class="block text-gray-400 text-sm font-bold mb-2">Mot de passe</label>
                    <input type="password" name="_password" id="password" class="w-full bg-brand-dark border border-gray-700 text-white rounded px-4 py-3 focus:outline-none focus:border-brand-red focus:ring-1 focus:ring-brand-red transition" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <button class="w-full bg-brand-red hover:bg-red-700 text-white font-bold py-3 px-4 rounded shadow-lg shadow-red-500/30 transition uppercase tracking-wide mt-2" type="submit">
                    S'identifier
                </button>

                <p class="text-center text-gray-500 text-sm mt-6">
                    Pas encore de compte ? <a href="{{ path('app_register') }}" class="text-brand-red hover:text-white transition font-semibold">S'inscrire</a>
                </p>

            </form>
        </div>
    </div>
{% endblock %}
