{% extends 'admin/layout.html.twig' %}

{% block content %}
    <div class="flex justify-between items-center mb-8">
        <h2 class="text-3xl font-bold text-white">Gestion des Événements</h2>
        <a href="{{ path('manager_events_create') }}" class="bg-brand-red hover:bg-red-700 text-white px-6 py-2 rounded font-bold transition">
            + Nouvel Événement
        </a>
    </div>

    <div class="bg-gray-900 border border-gray-800 rounded-lg shadow-xl overflow-hidden">
        <table class="w-full text-left">
            <thead class="bg-gray-800 text-gray-400 text-xs uppercase">
            <tr>
                <th class="p-4">Événement</th>
                <th class="p-4">Date</th>
                <th class="p-4">Statut</th>
                <th class="p-4 text-right">Actions</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-gray-800">
            {% for event in events %}
                <tr class="hover:bg-gray-800/50 transition">
                    <td class="p-4 font-bold text-white">{{ event.name }}</td>
                    <td class="p-4 text-gray-400">{{ event.date|date('d/m/Y') }}</td>
                    <td class="p-4">
                    <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase
                        {{ event.status.value == 'PUBLIE' ? 'bg-green-900 text-green-300' : 'bg-gray-700 text-gray-300' }}">
                        {{ event.status.value }}
                    </span>
                    </td>
                    <td class="p-4 text-right">
{#                        <a href="{{ path('manager_events_edit', {id: event.id}) }}" class="text-blue-400 hover:underline">Éditer</a>#}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
