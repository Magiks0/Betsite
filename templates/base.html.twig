<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}BetPlatform - Paris Sportifs{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'brand-red': '#e3000f', // Rouge façon Winamax
                        'brand-dark': '#121212', // Fond principal très sombre
                        'brand-card': '#1e1e1e', // Fond des cartes de matchs
                        'brand-hover': '#2d2d2d', // Survol des cotes
                        'brand-odd': '#ffcc00' // Jaune pour les chiffres des cotes
                    }
                }
            }
        }
    </script>

    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-brand-dark text-white font-sans antialiased">

<nav class="bg-brand-card border-b border-gray-800 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <div class="flex items-center">
                <a href="/" class="text-2xl font-black italic uppercase tracking-tighter text-white">
                    Bet<span class="text-brand-red">Platform</span>
                </a>
            </div>

            <div class="flex items-center space-x-4">
                {% if app.user %}
                    <div class="flex flex-col text-right">
                        <span class="text-xs text-gray-400">{{ app.user.email }}</span>
                        <span class="text-sm font-bold text-brand-odd">Solde: {{ app.user.balance }} €</span>
                    </div>
                    <a href="/mon-compte" class="bg-gray-700 hover:bg-gray-600 text-white px-3 py-2 rounded-md text-sm font-medium transition">
                        Mon Compte
                    </a>
                    <a href="{{ path('app_logout') }}" class="text-gray-400 hover:text-white text-sm">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="text-gray-300 hover:text-white px-3 py-2 text-sm font-medium">Connexion</a>
                    <a href="{{ path('app_register') }}" class="bg-brand-red hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm font-bold transition shadow-lg shadow-red-500/30">
                        S'inscrire
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</nav>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {% block body %}{% endblock %}
    <button id="floating-basket" class="hidden fixed bottom-6 right-6 bg-brand-red hover:bg-red-700 text-white font-bold py-3 px-5 rounded-full shadow-lg shadow-red-500/50 z-40 flex items-center gap-2 transition transform hover:scale-105">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"></path>
        </svg>
        <span class="bg-white text-brand-red rounded-full w-5 h-5 flex items-center justify-center text-xs font-black">1</span>
        <span class="uppercase tracking-wider text-sm">Panier</span>
    </button>
</main>

<footer class="bg-brand-card border-t border-gray-800 mt-12 py-8 text-center text-xs text-gray-500">
    <p>JOUER COMPORTE DES RISQUES : ENDETTEMENT, ISOLEMENT, DÉPENDANCE. POUR ÊTRE AIDÉ, APPELEZ LE 09 74 75 13 13 (APPEL NON SURTAXÉ).</p>
    <p class="mt-2">&copy; {{ 'now'|date('Y') }} BetPlatform (Projet Fictif ESGI). Interdit aux moins de 18 ans.</p>
</footer>

{% block javascripts %}
    {{ importmap('app') }}
{% endblock %}
</body>
</html>
